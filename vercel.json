{
  "version": 2,
  "buildCommand": "npm run build --prefix Projet-Sopra-Steria-main/frontend",
  "outputDirectory": "Projet-Sopra-Steria-main/frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "installCommand": "npm ci --ignore-scripts --prefix Projet-Sopra-Steria-main/frontend"
}
